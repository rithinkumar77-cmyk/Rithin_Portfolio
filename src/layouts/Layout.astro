---
import '../styles/global.css';
import { siteData } from '../data/site';
import Navigation from '../components/Navigation.astro';

interface Props {
	title?: string;
	description?: string;
	theme?: 'portfolio' | 'art';
}

const { title = siteData.siteName, description = siteData.description, theme = 'portfolio' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteData.url} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<title>{title}</title>
	</head>
	<body class={theme === 'art' ? 'art-theme' : undefined}>
		<header class="site-header">
			<div class="container site-header__inner">
				<a class="brand" href={base} aria-label="Rithin Kumar home">
					<span class="brand-mark">RK</span>
					<span>{siteData.name}</span>
				</a>
				<Navigation />
				<button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
					<span></span>
					<span></span>
				</button>
			</div>
		</header>
		<button class="nav-backdrop" type="button" aria-label="Close navigation" tabindex="-1"></button>

		<slot />

		<footer class="site-footer">
			<div class="container site-footer__inner">
				<span>© {new Date().getFullYear()} {siteData.name}</span>
				<span>{siteData.tagline}</span>
			</div>
		</footer>
		<script>
			const menuButton = document.querySelector<HTMLButtonElement>('.nav-toggle');
			const siteNavigation = document.querySelector<HTMLElement>('.site-nav');
			const menuBackdrop = document.querySelector<HTMLButtonElement>('.nav-backdrop');
			const siteHeader = document.querySelector<HTMLElement>('.site-header');

			const closeNavigation = () => {
				menuButton?.setAttribute('aria-expanded', 'false');
				menuButton?.setAttribute('aria-label', 'Menu');
				siteNavigation?.classList.remove('is-open');
				menuBackdrop?.classList.remove('is-visible');
				siteHeader?.classList.remove('menu-open');
				document.body.classList.remove('menu-open');
			};

			menuButton?.addEventListener('click', () => {
				const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
				menuButton.setAttribute('aria-expanded', String(!isExpanded));
				menuButton.setAttribute('aria-label', isExpanded ? 'Menu' : 'Close menu');
				siteNavigation?.classList.toggle('is-open', !isExpanded);
				menuBackdrop?.classList.toggle('is-visible', !isExpanded);
				siteHeader?.classList.toggle('menu-open', !isExpanded);
				document.body.classList.toggle('menu-open', !isExpanded);
			});

			siteNavigation?.addEventListener('click', (event) => {
				if (event.target instanceof HTMLAnchorElement) {
					closeNavigation();
				}
			});

			menuBackdrop?.addEventListener('click', closeNavigation);
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
					closeNavigation();
					menuButton.focus();
				}
			});
		</script>
	</body>
</html>
