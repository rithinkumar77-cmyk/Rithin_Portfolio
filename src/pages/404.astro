---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="The requested page could not be found.">
  <main class="page-shell">
    <div class="container">
      <div class="info-card">
        <div class="eyebrow">404</div>
        <h1>Page not found</h1>
        <p>The page you requested does not exist, but the portfolio is ready to continue elsewhere.</p>
        <div class="cta-row">
          <a class="button button--primary" href={import.meta.env.BASE_URL}>Return home</a>
        </div>
      </div>
    </div>
  </main>
</Layout>
