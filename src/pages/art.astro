---
import Layout from '../layouts/Layout.astro';
import SectionIntro from '../components/SectionIntro.astro';
---

<Layout title="Art & visual practice" description="Visual practice and creative work by Rithin Kumar.">
  <main class="page-shell">
    <div class="container">
      <SectionIntro eyebrow="Art & visual practice" title="A space for the visual side" description="The portfolio's visual direction brings a creative sensibility to a quality engineering practice." />

      <section class="section">
        <div class="art-note">
          <span class="art-note__index" aria-hidden="true">01</span>
          <div>
            <h2>Selected work will live here.</h2>
            <p>No personal artwork was included with the resume, so this page is kept open for Rithin's own visual work rather than filled with invented samples.</p>
          </div>
          <div class="art-note__mark" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        </div>
      </section>
    </div>
  </main>
</Layout>
